generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProfileRole {
  OWNER
  THERAPIST
}

enum Sex {
  FEMALE
  MALE
}

enum OutcomeType {
  ODI
  NDI
}

enum AuditAction {
  PATIENT_VIEWED
  PATIENT_CREATED
  PATIENT_UPDATED
  PATIENT_ARCHIVED
  PATIENT_EXPORTED
  VISIT_VIEWED
  VISIT_CREATED
  VISIT_UPDATED
  VISIT_CLOSED
  VISIT_AMENDED
  PLAN_CREATED
  PLAN_PDF_DOWNLOADED
  PLAN_EMAILED
  OUTCOME_RECORDED
  THERAPIST_CREATED
  THERAPIST_DEACTIVATED
  THERAPIST_RESTORED
}

model Clinic {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  createdAt   DateTime     @default(now()) @map("created_at")
  profiles    Profile[]
  patients    Patient[]
  exercises   Exercise[]
  auditEvents AuditEvent[]

  @@map("clinics")
}

model Exercise {
  id          String             @id @default(uuid()) @db.Uuid
  clinicId    String             @map("clinic_id") @db.Uuid
  name        String
  description String?
  // sciezka pliku w bucketcie "exercises" w Supabase Storage
  imagePath   String?            @map("image_path")
  defaultSets Int?               @map("default_sets")
  defaultReps Int?               @map("default_reps")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  clinic      Clinic             @relation(fields: [clinicId], references: [id])
  planItems   ExercisePlanItem[]

  @@index([clinicId])
  @@map("exercises")
}

model ExercisePlan {
  id          String             @id @default(uuid()) @db.Uuid
  patientId   String             @map("patient_id") @db.Uuid
  therapistId String             @map("therapist_id") @db.Uuid
  note        String?
  createdAt   DateTime           @default(now()) @map("created_at")
  patient     Patient            @relation(fields: [patientId], references: [id])
  therapist   Profile            @relation(fields: [therapistId], references: [id])
  items       ExercisePlanItem[]

  @@index([patientId])
  @@map("exercise_plans")
}

model ExercisePlanItem {
  id         String       @id @default(uuid()) @db.Uuid
  planId     String       @map("plan_id") @db.Uuid
  exerciseId String       @map("exercise_id") @db.Uuid
  // kolejnosc cwiczen w zestawie, taka jak ustawil terapeuta
  position   Int
  sets       Int?
  reps       Int?
  note       String?
  plan       ExercisePlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  exercise   Exercise     @relation(fields: [exerciseId], references: [id])

  @@index([planId])
  @@map("exercise_plan_items")
}

model Profile {
  // id jest rowne auth.users.id z Supabase, konto tworzy Supabase Auth
  id              String           @id @db.Uuid
  clinicId        String           @map("clinic_id") @db.Uuid
  fullName        String           @map("full_name")
  role            ProfileRole      @default(THERAPIST)
  // numer prawa wykonywania zawodu fizjoterapeuty (PWZFz)
  licenseNumber   String?          @map("license_number")
  active          Boolean          @default(true)
  createdAt       DateTime         @default(now()) @map("created_at")
  clinic          Clinic           @relation(fields: [clinicId], references: [id])
  visits          Visit[]
  plans           ExercisePlan[]
  amendments      VisitAmendment[]
  auditEvents     AuditEvent[]
  outcomeMeasures OutcomeMeasure[]

  @@index([clinicId])
  @@map("profiles")
}

model Patient {
  id              String           @id @default(uuid()) @db.Uuid
  clinicId        String           @map("clinic_id") @db.Uuid
  firstName       String           @map("first_name")
  lastName        String           @map("last_name")
  birthDate       DateTime?        @map("birth_date") @db.Date
  pesel           String?
  sex             Sex?
  address         String?
  phone           String?
  email           String?
  notes           String?
  archivedAt      DateTime?        @map("archived_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  clinic          Clinic           @relation(fields: [clinicId], references: [id])
  visits          Visit[]
  plans           ExercisePlan[]
  auditEvents     AuditEvent[]
  outcomeMeasures OutcomeMeasure[]

  @@unique([clinicId, pesel])
  @@index([clinicId])
  @@map("patients")
}

model Visit {
  id              String           @id @default(uuid()) @db.Uuid
  patientId       String           @map("patient_id") @db.Uuid
  therapistId     String           @map("therapist_id") @db.Uuid
  visitDate       DateTime         @map("visit_date") @db.Date
  interview       String?
  examination     String?
  diagnosis       String?
  // kod rozpoznania wg klasyfikacji ICD-10, np. M54.5
  icd10Code       String?          @map("icd10_code")
  // opis postepowania fizjoterapeutycznego, czyli co wykonano na wizycie
  treatment       String?
  recommendations String?
  closedAt        DateTime?        @map("closed_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  patient         Patient          @relation(fields: [patientId], references: [id])
  therapist       Profile          @relation(fields: [therapistId], references: [id])
  bodyMarkers     BodyMarker[]
  amendments      VisitAmendment[]

  @@index([patientId])
  @@map("visits")
}

// zamknietej wizyty nie edytujemy, poprawki dopisuje sie jako adnotacje
// z autorem i data, tak jak wymaga tego prawo dla dokumentacji medycznej
model VisitAmendment {
  id        String   @id @default(uuid()) @db.Uuid
  visitId   String   @map("visit_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  content   String
  createdAt DateTime @default(now()) @map("created_at")
  visit     Visit    @relation(fields: [visitId], references: [id])
  author    Profile  @relation(fields: [authorId], references: [id])

  @@index([visitId])
  @@map("visit_amendments")
}

model BodyMarker {
  id          String   @id @default(uuid()) @db.Uuid
  visitId     String   @map("visit_id") @db.Uuid
  // kod grupy miesniowej z mapy ciala, np. "czworoglowy-p"
  muscleGroup String   @map("muscle_group")
  // natezenie bolu w skali NRS 0-10
  painLevel   Int      @map("pain_level")
  painType    String?  @map("pain_type")
  note        String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  visit       Visit    @relation(fields: [visitId], references: [id])

  @@unique([visitId, muscleGroup])
  @@map("body_markers")
}

// dziennik zdarzen do rozliczalnosci z RODO: kto i kiedy mial wglad
// w dokumentacje albo ja zmienil. Wpisy tylko sie dopisuje, patrz migracja
model AuditEvent {
  id        String      @id @default(uuid()) @db.Uuid
  clinicId  String      @map("clinic_id") @db.Uuid
  actorId   String      @map("actor_id") @db.Uuid
  action    AuditAction
  patientId String?     @map("patient_id") @db.Uuid
  // krotki opis tam, gdzie zdarzenie nie dotyczy pacjenta, np. nazwa konta terapeuty
  details   String?
  createdAt DateTime    @default(now()) @map("created_at")
  clinic    Clinic      @relation(fields: [clinicId], references: [id])
  actor     Profile     @relation(fields: [actorId], references: [id])
  patient   Patient?    @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([clinicId, createdAt])
  @@map("audit_events")
}

// kwestionariusz niepelnosprawnosci wypelniony z pacjentem: ODI dla odcinka
// ledzwiowego, NDI dla szyi. Pomiaru, tak jak wpisu w dokumentacji, sie nie zmienia
model OutcomeMeasure {
  id          String      @id @default(uuid()) @db.Uuid
  patientId   String      @map("patient_id") @db.Uuid
  therapistId String      @map("therapist_id") @db.Uuid
  type        OutcomeType
  // punkty 0-5 za kazde z 10 pytan, w kolejnosci z formularza
  answers     Int[]
  createdAt   DateTime    @default(now()) @map("created_at")
  patient     Patient     @relation(fields: [patientId], references: [id])
  therapist   Profile     @relation(fields: [therapistId], references: [id])

  @@index([patientId])
  @@map("outcome_measures")
}
